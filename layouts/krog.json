{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "helm",
            "props": {
              "part": "brand"
            }
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "helm",
                "props": {
                  "part": "spaces"
                }
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "helm",
            "props": {
              "part": "footer"
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "helm",
            "props": {
              "part": "tabbar"
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "helm",
                      "props": {
                        "part": "pane-header"
                      }
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "asks",
                      "type": "column",
                      "children": [
                        {
                          "id": "asks-list",
                          "type": "block",
                          "content": {
                            "mod": "helm",
                            "props": {
                              "part": "asks"
                            }
                          },
                          "size": {
                            "weight": 1
                          },
                          "min": 120
                        },
                        {
                          "id": "agents",
                          "type": "block",
                          "content": {
                            "mod": "helm",
                            "props": {
                              "part": "agents"
                            }
                          },
                          "min": 120,
                          "size": {
                            "weight": 1
                          }
                        }
                      ]
                    },
                    {
                      "id": "claude-artifacts",
                      "type": "block",
                      "content": {
                        "mod": "helm",
                        "props": {
                          "part": "artifacts"
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "helm",
            "props": {
              "part": "status"
            }
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "theme": {
    "light": "frankenterm-gruvbox",
    "dark": "frankenterm-gruvbox"
  },
  "font": "DejaVu Sans Mono",
  "font_size": 15.33,
  "font_weight": 400,
  "ui_font": "DejaVu Sans",
  "link_handlers": [
    "chrome-profile"
  ]
}
